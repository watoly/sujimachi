{
  "name": "sujimachi",
  "version": "0.1.0",
  "description": "複数の CSV を横断してキーワードを探すオフラインの Web ツール",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
